{
  "name": "creator-insights",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start --hostname localhost",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:style": "npm run lint && npm run format:check",
    "format": "prettier --write . && npm run lint:fix",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@reduxjs/toolkit": "2.13.0",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "openai": "7.45.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.0",
    "redux-persist": "6.0.0",
    "sass": "1.106.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
